      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.6.2",
    "@types/react": "^18.0.19",
    "eslint": "^7.32.0",
    "eslint-config-vtex": "^12.9.5",
    "eslint-config-vtex-react": "^6.9.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^2.8.8",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.5",
    "@vercel/speed-insights": "^1.0.12",
    "axios": "^1.6.0",
    "graphql": "^16.6.0",
    "graphql-yoga": "^5.7.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.78.0"
  }
