{
  "name": "hp-cards",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "prepare": "husky install",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
